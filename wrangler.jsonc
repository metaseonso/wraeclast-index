// Cloudflare Worker for wraeclastindex.fyi. Cloudflare builds and publishes this on every push to main.
// The site itself is static files (served straight from the edge, out of dist/: tools/build.mjs copies the repo's
// website files there and minifies them, before every deploy); the worker only answers
// /data/market.json (live prices), /api/* (things a browser cannot fetch on its own) and
// /search (a redirect into the app's search). The service worker (sw.js) is a static file stamped by tools/build.mjs.
// The plain pages for search engines and AI search (item pages, lists,
// sitemaps, llms.txt, the Markdown copies) are files too: tools/build.mjs makes them with worker/seo.js at every
// deploy, and .github/workflows/rebuild.yml builds again every 6 hours so their prices stay fresh. A path that is
// no file gets dist/404.html with a 404, and never reaches the worker (not_found_handling).
// The hourly data jobs (tools/pricepull.py, exchange.py, market.py, leagues.py) run on GitHub Actions
// (.github/workflows/prices.yml at 2 past the hour, pages.yml at 17 past) and send their results in
// (worker/prices.js, worker/files.js).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wraeclast-index",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  // runs before every deploy: the files .assetsignore lets through, minified, into dist/ (never fails on a file it
  // cannot minify; that file ships as it is)
  "build": { "command": "node tools/build.mjs" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/data/market.json", "/data/rollprices.json", "/data/farmprices.json", "/data/bossprices.json", "/api/*", "/search"],
    "not_found_handling": "404-page"
  },
  // the deploy's version id: the market file's built parts are kept per deploy (worker/prices.js builtName)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    { "binding": "DB", "database_name": "wraeclast", "database_id": "d1c4d101-dce9-4f19-9dc3-4525eca2f17e", "migrations_dir": "worker/migrations" }
  ],
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
