# How long browsers keep each file (Cloudflare reads this on deploy; it is not served).
# Code and data change on deploy: keep 2 minutes, then use the kept copy while fetching the new one.
# Art never changes under the same name: keep it a month ("! Cache-Control" drops the general rule first).
# Fonts never change, and the drill-down page's data files are named by their content (tools/sync.py): keep a year.
# The drill-down page itself is small and names those files, so it is always checked (never an old page with new files).
# Repeat visits mostly skip all of this: the service worker (sw.js, served by the worker, never cached) keeps each
# deploy's files together in the browser.
/assets/*
  Cache-Control: public, max-age=120, stale-while-revalidate=600
/data/*
  Cache-Control: public, max-age=120, stale-while-revalidate=3600
/explore
  Cache-Control: public, max-age=0, must-revalidate
/assets/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/explore/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# The index's cut (tools/shards.py) is named by its content too: a year. Its manifest names those files, so it is
# always checked: an old manifest would name files the site no longer has.
/data/search/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/cards/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/seo/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/sprites/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
