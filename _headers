# How long browsers keep each file (Cloudflare reads this on deploy; it is not served).
# Code and data change on deploy: keep 2 minutes, then use the kept copy while fetching the new one.
# Art never changes under the same name: keep it a month ("! Cache-Control" drops the general rule first).
# Fonts never change, and the drill-down page's data files are named by their content (tools/sync.py): keep a year.
# The drill-down page itself is small and names those files, so it is always checked (never an old page with new files).
# Repeat visits mostly skip all of this: the service worker (sw.js, stamped by tools/build.mjs, always checked) keeps
# each deploy's files together in the browser.
/assets/*
  Cache-Control: public, max-age=120, stale-while-revalidate=600
/data/*
  Cache-Control: public, max-age=120, stale-while-revalidate=3600
/explore
  Cache-Control: public, max-age=0, must-revalidate
/assets/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/explore/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# The index's cut (tools/shards.py) is named by its content too: a year. Its manifest names those files, so it is
# always checked: an old manifest would name files the site no longer has.
/data/search/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/cards/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/seo/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/sprites/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# The crawler's files (tools/build.mjs, worker/seo.js): built again at every deploy and every 6 hours, so a copy is
# kept 5 minutes, then used while the new one is fetched. Every price on them carries its own checked time.
/item/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
/llms/*
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *
/llms.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/llms-full.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
# The Markdown copies: for a model to read, never a search result of their own (the page is the result)
/md/*
  ! Content-Type
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *
# The open data: any site may read it from a browser. (The files the worker answers, /data/market.json and the
# other live ones, set their own headers: worker/prices.js.)
/data/*
  Access-Control-Allow-Origin: *
/sw.js
  Cache-Control: no-cache
